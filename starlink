    // ===== ПОКАЗ ПРОФИЛЯ =====
    function showUserProfile(username) {
      const user = allUsers.find(u => u.username === username);
      if (!user) {
        showToast('Пользователь не найден');
        return;
      }
      currentProfileUser = user;
      profileAvatarBig.textContent = user.username.charAt(0).toUpperCase();
      profileNameBig.textContent = user.username;
      profileStatusBig.textContent = user.status || 'Новичок';
      profileBioBig.textContent = user.bio || 'Расскажи о себе...';
      
      profileStatsBig.innerHTML = `
        <div class="item"><div class="val">${user.stars}</div><div class="lbl">⭐ Звёзд</div></div>
        <div class="item"><div class="val">${user.tasks}</div><div class="lbl">📋 Заданий</div></div>
        <div class="item"><div class="val">${user.refs}</div><div class="lbl">👥 Рефералов</div></div>
        <div class="item"><div class="val">${user.donated}</div><div class="lbl">🎁 Донат</div></div>
      `;

      const isFriend = userData.friends.includes(username);
      profileFriendBtn.textContent = isFriend ? '✅ В друзьях' : '➕ В друзья';
      profileFriendBtn.style.background = isFriend ? '#EBE4DD' : '#F7F3EF';
      userProfileOverlay.classList.add('show');
    }

    profileCloseBtn.addEventListener('click', () => userProfileOverlay.classList.remove('show'));
    userProfileOverlay.addEventListener('click', (e) => { if (e.target === this) this.classList.remove('show'); });

    profileFriendBtn.addEventListener('click', function() {
      if (!currentProfileUser) return;
      if (userData.friends.includes(currentProfileUser.username)) {
        showToast(`👤 ${currentProfileUser.username} уже в друзьях`);
        return;
      }
      userData.friends.push(currentProfileUser.username);
      profileFriendBtn.textContent = '✅ В друзьях';
      profileFriendBtn.style.background = '#EBE4DD';
      renderUsersList(document.querySelector('[data-chat-tab].active')?.dataset.chatTab || 'all', chatSearchInput.value.trim());
      showToast(`✅ ${currentProfileUser.username} добавлен в друзья!`);
    });

    profileWriteBtn.addEventListener('click', function() {
      if (!currentProfileUser) return;
      userProfileOverlay.classList.remove('show');
      setTimeout(() => openPrivateChat(currentProfileUser.username), 300);
    });

    // ===== ЛИЧНЫЙ ЧАТ =====
    function openPrivateChat(username) {
      if (username === userData.username) { showToast('Это вы'); return; }
      currentChatPartner = username;
      if (!privateChats[username]) privateChats[username] = { messages: [], pending: true };
      chatPartnerName.textContent = `Чат с ${username}`;
      renderChatMessages();
      switchScreen('privateChat');
    }

    function renderChatMessages() {
      const chat = privateChats[currentChatPartner];
      if (!chat) {
        chatMessagesContainer.innerHTML = `<div class="empty-state"><span class="emoji">💬</span>Вы ещё не начали общение</div>`;
        return;
      }
      if (chat.messages.length === 0) {
        chatMessagesContainer.innerHTML = `<div class="empty-state"><span class="emoji">💬</span>${chat.pending ? 'Отправьте первое сообщение для начала общения' : 'Начните общение'}</div>`;
        return;
      }
      chatMessagesContainer.innerHTML = chat.messages.map(msg => `
        <div class="chat-message ${msg.from === userData.username ? 'own' : ''}">
          <div class="author">${msg.from === userData.username ? 'Вы' : msg.from}</div>
          <div class="text">${msg.text}</div>
          <div class="time">${msg.time}</div>
          ${msg.from === userData.username && chat.pending && chat.messages.length === 1 ? '<div class="pending">⏳ Ожидание подтверждения</div>' : ''}
        </div>
      `).join('');
      chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
    }

    chatSendBtn.addEventListener('click', function() {
      const text = chatInput.value.trim();
      if (!text) return;
      const chat = privateChats[currentChatPartner];
      if (!chat) return;
      if (chat.pending && chat.messages.length > 0) {
        showToast('⏳ Ожидайте подтверждения от пользователя');
        return;
      }
      chat.messages.push({ from: userData.username, text: text, time: new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) });
      chat.pending = true;
      chatInput.value = '';
      renderChatMessages();
      showToast('✅ Сообщение отправлено!');
      setTimeout(() => {
        if (chat.pending) {
          chat.pending = false;
          chat.messages.push({ from: currentChatPartner, text: 'Привет! Рад(а) познакомиться!', time: new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) });
          renderChatMessages();
          showToast(`📩 Новое сообщение от ${currentChatPartner}`);
        }
      }, 3000);
    });

    chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') chatSendBtn.click(); });
    chatBackBtn.addEventListener('click', () => { switchScreen('chats'); currentChatPartner = null; });

    // ===== КОПИРОВАНИЕ ССЫЛКИ =====
    document.getElementById('copyRefLink').addEventListener('click', function() {
      const text = refLink.textContent;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => showToast('✅ Ссылка скопирована!'));
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showToast('✅ Ссылка скопирована!');
      }
    });

    // ===== ОБНОВЛЕНИЕ РЕФЕРАЛКИ =====
    function updateReferral() {
      refLink.textContent = userData.refLink;
      refCount.textContent = userData.invitedUsers.length;
      refEarned.textContent = `+${userData.refEarnPerUser}`;
      if (userData.invitedUsers.length === 0) {
        refListContainer.innerHTML = `<div class="empty-state"><span class="emoji">👤</span>Пока никто не перешёл</div>`;
      } else {
        refListContainer.innerHTML = userData.invitedUsers.map((u, i) => `
          <div class="ref-user-item">
            <div class="avatar">${u.username.charAt(0).toUpperCase()}</div>
            <div class="info">
              <div class="name">${u.username}</div>
              <div class="date">Присоединился: ${u.date}</div>
            </div>
            <div class="badge">✅ +${userData.refEarnPerUser} ⭐</div>
          </div>
        `).join('');
      }
    }

    // ===== СИМУЛЯЦИЯ ПРИГЛАШЕНИЯ =====
    function addTestReferral() {
      const names = ['Alex', 'Max', 'Kate', 'John', 'Lena', 'Mike', 'Sofia', 'Tom'];
      const name = names[Math.floor(Math.random() * names.length)];
      const username = `${name}${Math.floor(Math.random() * 100)}`;
      if (userData.invitedUsers.some(u => u.username === username)) return;
      userData.invitedUsers.push({ username: username, date: new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' }) });
      userData.refs += 1;
      userData.balance += userData.refEarnPerUser;
      userData.stars += userData.refEarnPerUser;
      registerUser(username);
      updateProfile();
      updateReferral();
      showToast(`👤 ${username} присоединился по вашей ссылке! +${userData.refEarnPerUser} ⭐`);
