      const entry = {
        id: Date.now(),
        title: title,
        text: text,
        image: image,
        time: new Date().toLocaleString('ru-RU', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }),
        views: views || []
      };
      broadcastHistory.unshift(entry);
      renderBroadcastHistory();
    }

