            <div class="stat-row"><span class="label">Всего пользователей</span><span class="value">${totalUsers}</span></div>
            <div class="stat-row"><span class="label">Всего ⭐ звёзд</span><span class="value">${totalStars}</span></div>
            <div class="stat-row"><span class="label">Всего 📋 заданий</span><span class="value">${totalTasks}</span></div>
            <div class="stat-row"><span class="label">Всего 🎁 донатов</span><span class="value">${totalDonated} ⭐</span></div>
            <div class="stat-row"><span class="label">Всего 👥 рефералов</span><span class="value">${totalRefs}</span></div>
            <div class="stat-row"><span class="label">Среднее ⭐ на пользователя</span><span class="value">${avgStars}</span></div>
