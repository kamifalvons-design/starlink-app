        users = users.filter(u => u.username.toLowerCase().includes(query));
      }
      const totalPages = Math.ceil(users.length / usersPerPage) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * usersPerPage;
      const end = start + usersPerPage;
      const pageUsers = users.slice(start, end);

      if (pageUsers.length === 0) {
        usersListContainer.innerHTML = `<div class="empty-state"><span class="emoji">👤</span>Пока нет пользователей</div>`;
        paginationContainer.innerHTML = '';
        return;
      }

      usersListContainer.innerHTML = pageUsers.map(u => {
        const isFriend = userData.friends.includes(u.username);
        return `
          <div class="user-item" data-username="${u.username}">
            <div class="avatar">${u.username.charAt(0).toUpperCase()}</div>
            <div class="info">
              <div class="name">${u.username}</div>
              <div class="status">${u.status || 'Новичок'} ${isFriend ? '🤝' : ''}</div>
            </div>
            <div class="actions">
              <button class="view-profile" data-username="${u.username}">👤</button>
              <button class="write-message" data-username="${u.username}">✉️</button>
            </div>
          </div>
        `;
      }).join('');

      if (totalPages > 1) {
        let paginationHTML = '';
        paginationHTML += `<button class="${currentPage === 1 ? 'active' : ''}" data-page="${currentPage}">${currentPage}</button>`;
        if (currentPage < totalPages) {
          paginationHTML += `<span>...</span>`;
          paginationHTML += `<button data-page="${totalPages}">${totalPages}</button>`;
        }
        paginationHTML += `<button data-page="${currentPage + 1}" ${currentPage >= totalPages ? 'disabled' : ''}>→</button>`;
        paginationContainer.innerHTML = paginationHTML;
        paginationContainer.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', function() {
            const page = parseInt(this.dataset.page);
            if (page && page !== currentPage) {
              currentPage = page;
              renderUsersList(filter, search);
            }
          });
        });
      } else {
        paginationContainer.innerHTML = '';
      }

      document.querySelectorAll('.view-profile').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          const username = this.dataset.username;
          showUserProfile(username);
        });
      });

      document.querySelectorAll('.write-message').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          const username = this.dataset.username;
          openPrivateChat(username);
        });
      });

      document.querySelectorAll('.user-item').forEach(item => {
        item.addEventListener('click', function() {
          const username = this.dataset.username;
          showUserProfile(username);
        });
      });
    }

    // ===== РЕНДЕР ЛИДЕРОВ =====
    function renderLeaders(type = 'tasks') {
      let sortedUsers = [];
      let label = '';

      if (type === 'tasks') {
        sortedUsers = [...allUsers].sort((a, b) => b.tasks - a.tasks);
        label = 'заданий';
      } else if (type === 'stars') {
        sortedUsers = [...allUsers].sort((a, b) => b.stars - a.stars);
        label = 'звёзд';
      } else if (type === 'donaters') {
        sortedUsers = [...allUsers].sort((a, b) => b.donated - a.donated);
        label = '⭐ доната';
      }

      const topUsers = sortedUsers.slice(0, 10);

      if (topUsers.length === 0 || topUsers.every(u => (type === 'tasks' ? u.tasks : type === 'stars' ? u.stars : u.donated) === 0)) {
        leadersListContainer.innerHTML = `<div class="empty-state"><span class="emoji">🏆</span>Пока нет лидеров</div>`;
        return;
      }

      leadersListContainer.innerHTML = topUsers.map((u, index) => {
        const value = type === 'tasks' ? u.tasks : type === 'stars' ? u.stars : u.donated;
        const isCurrentUser = u.id === userData.id;
        let positionClass = '';
        let badgeText = '';
        
        if (index === 0) { positionClass = 'gold'; badgeText = '🥇'; }
        else if (index === 1) { positionClass = 'silver'; badgeText = '🥈'; }
        else if (index === 2) { positionClass = 'bronze'; badgeText = '🥉'; }
        else { positionClass = ''; badgeText = `#${index + 1}`; }

        return `
          <div class="leader-item" data-username="${u.username}" style="${isCurrentUser ? 'border-color:#605F5B;border-width:2px;' : ''}">
            <div class="position ${positionClass}">${badgeText}</div>
            <div class="avatar">${u.username.charAt(0).toUpperCase()}</div>
            <div class="info">
              <div class="name">${u.username} ${isCurrentUser ? '👈' : ''}</div>
              <div class="value">${value} ${label}</div>
            </div>
            ${positionClass ? `<div class="badge ${positionClass}">${index === 0 ? '🥇' : index === 1 ? '🥈' : '🥉'}</div>` : ''}
          </div>
        `;
      }).join('');

      document.querySelectorAll('.leader-item').forEach(item => {
        item.addEventListener('click', function() {
          const username = this.dataset.username;
          showUserProfile(username);
        });
      });
    }

