    // ===== РЕНДЕР ПОСТОВ =====
    function renderPosts() {
      if (posts.length === 0) {
        postsContainer.innerHTML = `<div class="empty-state"><span class="emoji">📭</span>Пока нет постов</div>`;
        return;
      }
      postsContainer.innerHTML = posts.map(post => {
        let pollHTML = '';
        const hasVoted = votedPolls.has(post.id);
        if (post.poll) {
          const totalVotes = post.poll.options.reduce((sum, o) => sum + o.votes, 0);
          pollHTML = `
            <div class="poll" data-poll="${post.id}">
              <div class="poll-question">${post.poll.question}</div>
              ${post.poll.options.map((opt, idx) => {
                const pct = totalVotes > 0 ? (opt.votes / totalVotes * 100) : 0;
                const votedClass = hasVoted ? ' voted' : '';
                return `<div class="poll-option${votedClass}" data-post="${post.id}" data-opt="${idx}"><span>${opt.text}</span><div class="vote-bar"><div class="fill" style="width:${pct}%;"></div></div><span class="vote-count">${opt.votes}</span></div>`;
              }).join('')}
              <div class="poll-votes">${totalVotes} голосов ${hasVoted ? '· Вы проголосовали' : ''}</div>
            </div>
          `;
        }
        const imageHTML = post.image ? `<img src="${post.image}" class="post-image">` : '';
        const commentsHTML = post.comments.length > 0 ? `<div class="comments">${post.comments.map(c => `<div class="comment"><span class="author">${c.author}</span><span class="text">${c.text}</span><span class="time">${c.time}</span></div>`).join('')}</div>` : '';
        const reactionKeys = Object.keys(post.reactions || {});
        const reactionsHTML = reactionKeys.length > 0 ? reactionKeys.map(r => `<span style="font-size:0.9rem;">${r} ${post.reactions[r]}</span>`).join(' ') : '';

        return `
          <div class="post" data-post="${post.id}">
            <div class="post-header">
              <span class="post-author${post.isAnon ? ' anonymous' : ''}" data-user="${post.isAnon ? 'Аноним' : post.author}">${post.isAnon ? '🕵️ Аноним' : post.author}</span>
              ${post.isAnon ? '<span class="post-badge">anon</span>' : ''}
              <span class="post-time">${post.time}</span>
            </div>
            ${post.text ? `<div class="post-text">${post.text}</div>` : ''}
            ${imageHTML}
            ${pollHTML}
            <div class="post-actions-row">
              ${REACTIONS.map(r => {
                const isUserReaction = post.userReaction === r;
                return `<button class="post-action ${isUserReaction ? 'reacted' : ''}" data-action="react" data-post="${post.id}" data-reaction="${r}"><span class="icon">${r}</span><span class="count">${(post.reactions && post.reactions[r]) || 0}</span></button>`;
              }).join('')}
              <button class="post-action" data-action="comment" data-post="${post.id}"><span class="icon">💬</span> ${post.comments.length}</button>
            </div>
            ${reactionsHTML ? `<div style="margin-top:4px;font-size:0.85rem;display:flex;gap:6px;flex-wrap:wrap;">${reactionsHTML}</div>` : ''}
            ${commentsHTML}
            <div class="comment-input-wrap" data-post="${post.id}">
              <input type="text" placeholder="Написать комментарий..." class="comment-input">
              <button class="comment-send">Отправить</button>
            </div>
          </div>
        `;
      }).join('');

      document.querySelectorAll('[data-action="react"]').forEach(btn => {
        btn.addEventListener('click', function() {
          const postId = parseInt(this.dataset.post);
          const reaction = this.dataset.reaction;
          const post = posts.find(p => p.id === postId);
          if (!post) return;
          if (post.userReaction) {
            if (post.userReaction === reaction) {
              post.reactions[reaction] = (post.reactions[reaction] || 1) - 1;
              if (post.reactions[reaction] <= 0) delete post.reactions[reaction];
              post.userReaction = null;
              renderPosts();
              return;
            }
            const oldReaction = post.userReaction;
            post.reactions[oldReaction] = (post.reactions[oldReaction] || 1) - 1;
            if (post.reactions[oldReaction] <= 0) delete post.reactions[oldReaction];
          }
          post.reactions[reaction] = (post.reactions[reaction] || 0) + 1;
          post.userReaction = reaction;
          renderPosts();
        });
      });

      document.querySelectorAll('.comment-send').forEach(btn => {
        btn.addEventListener('click', function() {
          const wrap = this.closest('.comment-input-wrap');
          const input = wrap.querySelector('.comment-input');
          const postId = parseInt(wrap.dataset.post);
          const text = input.value.trim();
          if (!text) return;
          const post = posts.find(p => p.id === postId);
          if (post) {
            post.comments.push({ id: ++commentIdCounter, author: userData.username, text: text, time: new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) });
            input.value = '';
            renderPosts();
          }
        });
      });

      document.querySelectorAll('.poll-option:not(.voted)').forEach(el => {
        el.addEventListener('click', function() {
          const postId = parseInt(this.dataset.post);
          const optIdx = parseInt(this.dataset.opt);
          const post = posts.find(p => p.id === postId);
          if (votedPolls.has(postId)) { showToast('Вы уже проголосовали в этом опросе'); return; }
          if (post && post.poll) {
            post.poll.options[optIdx].votes += 1;
            votedPolls.add(postId);
            renderPosts();
            showToast('✅ Голос учтён!');
          }
        });
      });
    }

