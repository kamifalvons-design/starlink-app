      color: #605F5B;
      word-wrap: break-word;
    }

    .chat-message .time {
      font-size: 0.55rem;
      color: #8B8782;
      text-align: right;
      margin-top: 2px;
    }

    .chat-message .pending {
      font-size: 0.6rem;
      color: #8B8782;
      font-style: italic;
      margin-top: 2px;
    }

    .chat-input-wrap {
      display: flex;
      gap: 6px;
      margin-top: 8px;
      align-items: center;
    }

    .chat-input-wrap input[type="text"] {
      flex: 1;
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 8px 14px;
      font-size: 0.85rem;
      background: #F7F3EF;
      color: #605F5B;
      outline: none;
    }

    .chat-input-wrap input[type="text"]:focus {
      border-color: #8B8782;
    }

    .chat-input-wrap .btn-send {
      background: #605F5B;
      color: #F7F3EF;
      border: none;
      padding: 8px 16px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      transition: 0.1s;
    }

    .chat-input-wrap .btn-send:active {
      transform: scale(0.95);
      background: #8B8782;
    }

    .chat-back {
      background: #EBE4DD;
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 4px 12px;
      font-size: 0.7rem;
      cursor: pointer;
      color: #8B8782;
      margin-bottom: 8px;
      align-self: flex-start;
    }

    .chat-back:active {
      transform: scale(0.95);
    }

    .search-header {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .search-header input {
      flex: 1;
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 8px 14px;
      font-size: 0.85rem;
      background: #F7F3EF;
      color: #605F5B;
      outline: none;
    }

    .search-header input:focus {
      border-color: #8B8782;
    }

    .search-header .btn-search {
      background: #605F5B;
      color: #F7F3EF;
      border: none;
      border-radius: 40px;
      padding: 8px 12px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: 0.1s;
    }

    .search-header .btn-search:active {
      transform: scale(0.95);
      background: #8B8782;
    }

    .user-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      background: #EBE4DD;
      border-radius: 16px;
      border: 1px solid #C7C0B9;
      margin-bottom: 6px;
      cursor: pointer;
      transition: 0.1s;
    }

    .user-item:active {
      transform: scale(0.98);
      background: #C7C0B9;
    }

    .user-item .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #C7C0B9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      color: #F7F3EF;
      font-weight: 600;
      flex-shrink: 0;
    }

    .user-item .info {
      flex: 1;
    }

    .user-item .info .name {
      font-weight: 500;
      color: #605F5B;
      font-size: 0.9rem;
    }

    .user-item .info .status {
      font-size: 0.65rem;
      color: #8B8782;
    }

    .user-item .actions {
      display: flex;
      gap: 4px;
    }

    .user-item .actions button {
      background: #F7F3EF;
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 2px 10px;
      font-size: 0.65rem;
      cursor: pointer;
      color: #605F5B;
      transition: 0.1s;
    }

    .user-item .actions button:active {
      transform: scale(0.95);
      background: #EBE4DD;
    }

    .user-item .actions button.friend {
      background: #605F5B;
      color: #F7F3EF;
      border-color: #605F5B;
    }

    .profile-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(6px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      padding: 20px;
    }

    .profile-overlay.show {
      display: flex;
    }

    .profile-overlay .modal {
      background: #F7F3EF;
      border-radius: 32px;
      padding: 24px 20px;
      max-width: 380px;
      width: 100%;
      border: 1px solid #EBE4DD;
      box-shadow: 0 20px 60px rgba(0,0,0,0.2);
      text-align: center;
    }

    .profile-overlay .modal .avatar-big {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: #C7C0B9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      color: #F7F3EF;
      margin: 0 auto 10px;
      font-weight: 600;
    }

    .profile-overlay .modal .name {
      font-size: 1.3rem;
      font-weight: 700;
      color: #605F5B;
    }

    .profile-overlay .modal .status {
      font-size: 0.85rem;
      color: #8B8782;
    }

    .profile-overlay .modal .bio {
      font-size: 0.9rem;
      color: #605F5B;
      margin: 8px 0;
      padding: 8px;
      background: #EBE4DD;
      border-radius: 12px;
    }

    .profile-overlay .modal .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 4px;
      margin: 8px 0;
    }

    .profile-overlay .modal .stats .item {
      background: #EBE4DD;
      border-radius: 8px;
      padding: 4px 8px;
      text-align: center;
    }

    .profile-overlay .modal .stats .item .val {
      font-weight: 700;
      color: #605F5B;
      font-size: 0.9rem;
    }

    .profile-overlay .modal .stats .item .lbl {
      font-size: 0.55rem;
      color: #8B8782;
    }

    .profile-overlay .modal .actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .profile-overlay .modal .actions button {
      padding: 8px 20px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      background: #F7F3EF;
      font-weight: 500;
      font-size: 0.85rem;
      cursor: pointer;
      transition: 0.1s;
      color: #605F5B;
    }

    .profile-overlay .modal .actions button:active {
      transform: scale(0.95);
    }

    .profile-overlay .modal .actions .btn-primary {
      background: #605F5B;
      color: #F7F3EF;
      border-color: #605F5B;
    }

    .profile-overlay .modal .actions .btn-primary:active {
      background: #8B8782;
    }

    .profile-overlay .modal .close-btn {
      margin-top: 12px;
      padding: 6px 20px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      background: #EBE4DD;
      color: #8B8782;
      cursor: pointer;
      font-size: 0.8rem;
    }

    .profile-overlay .modal .close-btn:active {
      transform: scale(0.95);
    }

    .pagination {
      display: flex;
      gap: 4px;
      justify-content: center;
      align-items: center;
      padding: 8px 0;
      font-size: 0.75rem;
      color: #8B8782;
    }

    .pagination button {
      background: #EBE4DD;
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 2px 10px;
      cursor: pointer;
      color: #605F5B;
      font-size: 0.7rem;
      transition: 0.1s;
    }

    .pagination button:active {
      transform: scale(0.95);
      background: #C7C0B9;
    }

    .pagination button.active {
      background: #605F5B;
      color: #F7F3EF;
      border-color: #605F5B;
    }

    .pagination span {
      padding: 0 4px;
    }

    .broadcast-form textarea {
      width: 100%;
      border: 1px solid #C7C0B9;
      border-radius: 16px;
      padding: 10px 14px;
      font-size: 0.9rem;
      resize: none;
      background: #F7F3EF;
      color: #605F5B;
      outline: none;
      font-family: inherit;
      min-height: 80px;
      margin-bottom: 10px;
    }

    .broadcast-form textarea:focus {
      border-color: #8B8782;
    }

    .broadcast-form .file-upload {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .broadcast-form .file-upload .btn-attach {
      background: #EBE4DD;
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 6px 14px;
      font-size: 0.8rem;
      cursor: pointer;
      color: #605F5B;
      transition: 0.1s;
    }

    .broadcast-form .file-upload .btn-attach:active {
      transform: scale(0.95);
      background: #C7C0B9;
    }

    .broadcast-form .file-upload .file-name {
      font-size: 0.75rem;
      color: #8B8782;
    }

    .broadcast-form .price-info {
      background: #EBE4DD;
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 10px;
      border: 1px solid #C7C0B9;
      font-size: 0.85rem;
      color: #605F5B;
    }

    .broadcast-form .price-info .cost {
      font-weight: 700;
      color: #d4a843;
    }

    .btn-broadcast {
      background: #605F5B;
      color: #F7F3EF;
      border: none;
      padding: 10px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.1s;
      width: 100%;
    }

    .btn-broadcast:active {
      background: #8B8782;
      transform: scale(0.98);
    }

    .btn-broadcast:disabled {
      background: #C7C0B9;
      cursor: not-allowed;
      opacity: 0.6;
    }

    /* ===== УВЕДОМЛЕНИЯ ===== */
    .notification-item {
      background: #EBE4DD;
      border-radius: 16px;
      padding: 14px 16px;
      border: 1px solid #C7C0B9;
      margin-bottom: 8px;
      cursor: pointer;
      transition: 0.1s;
    }

    .notification-item:active {
      transform: scale(0.98);
      background: #C7C0B9;
    }

    .notification-item .header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .notification-item .header .channel {
      font-weight: 600;
      color: #605F5B;
      font-size: 0.8rem;
      background: #F7F3EF;
      padding: 0 8px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
    }

    .notification-item .header .time {
      font-size: 0.65rem;
      color: #8B8782;
      margin-left: auto;
    }

    .notification-item .title {
      font-weight: 700;
      color: #605F5B;
      font-size: 1rem;
      margin-bottom: 2px;
    }

    .notification-item .text {
      font-size: 0.9rem;
      color: #605F5B;
      line-height: 1.4;
    }

    .notification-item .image {
      width: 100%;
      border-radius: 12px;
      margin-top: 8px;
      max-height: 200px;
      object-fit: cover;
      background: #C7C0B9;
    }

    .notification-item .read {
      font-size: 0.65rem;
      color: #8B8782;
      margin-top: 4px;
      text-align: right;
    }

    .notification-item.unread {
      border-color: #605F5B;
      background: #F7F3EF;
    }

    .notification-item.unread .channel {
      background: #605F5B;
      color: #F7F3EF;
      border-color: #605F5B;
    }

    .notification-tabs {
      display: flex;
      gap: 6px;
      background: #EBE4DD;
      padding: 4px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      margin-bottom: 10px;
    }

    .notification-tab {
      flex: 1;
      text-align: center;
      padding: 6px 0;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 500;
      color: #8B8782;
      cursor: pointer;
      transition: 0.15s;
      border: none;
      background: transparent;
    }

    .notification-tab.active {
      background: #F7F3EF;
      color: #605F5B;
      border: 1px solid #C7C0B9;
      font-weight: 600;
    }

    .notification-tab .count {
      background: #605F5B;
      color: #F7F3EF;
      border-radius: 40px;
      padding: 0 6px;
      font-size: 0.6rem;
      margin-left: 4px;
    }

    .notif-empty {
      text-align: center;
      padding: 30px 20px;
      color: #8B8782;
      font-size: 0.9rem;
    }

    .notif-empty .emoji {
      font-size: 2.5rem;
      display: block;
      margin-bottom: 10px;
    }

    /* Статистика просмотров (только для админа) */
    .admin-stats {
      background: #EBE4DD;
      border-radius: 12px;
      padding: 10px 14px;
      border: 1px solid #C7C0B9;
      margin-bottom: 8px;
      font-size: 0.8rem;
      color: #605F5B;
    }

    .admin-stats .stat-row {
      display: flex;
      justify-content: space-between;
      padding: 2px 0;
      border-bottom: 1px dashed #C7C0B9;
    }

    .admin-stats .stat-row:last-child {
      border-bottom: none;
    }

    .admin-stats .label {
      color: #8B8782;
    }

    .admin-stats .value {
      font-weight: 600;
    }

    /* История рассылок */
    .broadcast-history-item {
      background: #EBE4DD;
      border-radius: 12px;
      padding: 10px 12px;
      border: 1px solid #C7C0B9;
      margin-bottom: 6px;
    }

    .broadcast-history-item .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2px;
    }

    .broadcast-history-item .header .title {
      font-weight: 600;
      color: #605F5B;
      font-size: 0.85rem;
    }

    .broadcast-history-item .header .time {
      font-size: 0.6rem;
      color: #8B8782;
    }

    .broadcast-history-item .text {
      font-size: 0.8rem;
      color: #605F5B;
      margin: 4px 0;
    }

    .broadcast-history-item .image {
      max-height: 100px;
      border-radius: 8px;
      margin-top: 4px;
      width: 100%;
      object-fit: cover;
    }

    .broadcast-history-item .stats {
      display: flex;
      gap: 12px;
      margin-top: 6px;
      font-size: 0.7rem;
      color: #8B8782;
    }

    .broadcast-history-item .stats .viewers {
      color: #605F5B;
      font-weight: 500;
    }

    /* ===== КНОПКИ ДЛЯ ТЕСТА (ВИДНЫ ТОЛЬКО АДМИНУ) ===== */
    .test-admin-buttons {
      display: flex;
      gap: 8px;
      margin-top: 10px;
    }

    .test-admin-buttons button {
      flex: 1;
      padding: 10px;
      border-radius: 40px;
      border: none;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: 0.1s;
    }

    .test-admin-buttons button:active {
      transform: scale(0.95);
    }

    .test-admin-buttons .btn-approve {
      background: #4CAF50;
      color: #fff;
    }

    .test-admin-buttons .btn-reject {
      background: #E53935;
      color: #fff;
    }

    .test-admin-buttons .btn-approve:disabled,
    .test-admin-buttons .btn-reject:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .test-admin-buttons .hint {
      font-size: 0.6rem;
      color: #8B8782;
      text-align: center;
      width: 100%;
      margin-top: 4px;
    }

    @media (max-width: 420px) {
      .app-card { padding: 16px 12px; }
      .nav-item { font-size: 0.7rem; padding: 5px 8px; }
      .profile-avatar { width: 60px; height: 60px; font-size: 1.8rem; }
      .profile-name { font-size: 1rem; }
      .stats-grid { grid-template-columns: repeat(4, 1fr); gap: 4px; }
      .stat-item .value { font-size: 0.9rem; }
      .balance-display .amount { font-size: 2rem; }
      .post-btn { font-size: 0.65rem; padding: 4px 10px; }
      .ref-stats { flex-direction: column; gap: 6px; }
      .post-actions-row { gap: 4px; }
      .post-action { font-size: 0.65rem; padding: 2px 4px; }
      .donat-grid { grid-template-columns: repeat(3, 1fr); gap: 4px; }
      .donat-item .amount { font-size: 1rem; }
      .profile-overlay .modal .stats { grid-template-columns: repeat(2, 1fr); }
      .test-admin-buttons { flex-direction: column; }
    }
  </style>
</head>
<body>
  <div class="app-card">
    <div class="header">
      <div class="app-title">
        StarLink
        <span class="mini">мини-приложение</span>
      </div>
      <div class="user-badge" id="headerProfileBtn">
        <span id="headerUsername" style="color:#605F5B;">User0000</span>
        <span class="stars">
          <span class="milk-star"></span> <span id="headerStars">0</span>
        </span>
      </div>
    </div>

    <!-- ===== ЛЕНТА ===== -->
    <div id="feedScreen" class="screen active">
      <div class="tabs">
        <div class="tab active">Подписки</div>
        <div class="tab">Лучшее</div>
        <div class="tab">Свежее</div>
      </div>
      <div class="create-post">
        <div class="greeting">Что нового, <strong id="feedUsername">User0000</strong>?</div>
        <textarea id="postText" placeholder="Напишите что-нибудь..." rows="2"></textarea>
        <input type="file" id="postImageInput" accept="image/*" style="display:none;">
        <div class="post-actions">
          <button class="post-btn" id="photoBtn">📷 Фото</button>
          <button class="post-btn" id="pollBtn">📊 Опрос</button>
          <div class="anon-toggle" id="anonToggle"><span class="dot"></span> Анонимно</div>
          <button class="post-btn publish" id="publishBtn">Опубликовать</button>
        </div>
        <div id="pollCreator" style="display:none;margin-top:8px;background:#F7F3EF;border-radius:12px;padding:10px;border:1px solid #C7C0B9;">
          <input type="text" id="pollQuestion" placeholder="Вопрос опроса" style="width:100%;border:none;background:transparent;padding:4px 0;outline:none;font-size:0.85rem;color:#605F5B;border-bottom:1px solid #C7C0B9;margin-bottom:6px;">
          <div id="pollOptions">
            <input type="text" class="poll-option-input" placeholder="Вариант 1" style="width:100%;border:1px solid #C7C0B9;border-radius:40px;padding:4px 12px;margin-bottom:4px;font-size:0.8rem;background:#F7F3EF;outline:none;">
            <input type="text" class="poll-option-input" placeholder="Вариант 2" style="width:100%;border:1px solid #C7C0B9;border-radius:40px;padding:4px 12px;margin-bottom:4px;font-size:0.8rem;background:#F7F3EF;outline:none;">
          </div>
          <button id="addPollOption" style="font-size:0.7rem;color:#8B8782;background:none;border:none;cursor:pointer;padding:4px 0;">+ Добавить вариант</button>
        </div>
        <div id="imagePreview" style="display:none;margin-top:6px;position:relative;">
          <img id="previewImg" style="max-height:120px;border-radius:12px;border:1px solid #C7C0B9;">
          <button id="removeImage" style="position:absolute;top:4px;right:4px;background:#605F5B;color:#F7F3EF;border:none;border-radius:50%;width:20px;height:20px;cursor:pointer;font-size:0.7rem;">✕</button>
        </div>
      </div>
      <div id="postsContainer"><div class="empty-state"><span class="emoji">📭</span>Пока нет постов</div></div>
    </div>

    <!-- ===== ЗАДАНИЯ ===== -->
    <div id="tasksScreen" class="screen">
      <div class="task-card">
        <div class="task-title">📝 Регистрация на сайте</div>
        <div class="task-desc">Перейдите по ссылке и зарегистрируйтесь</div>
        <div class="task-reward">Награда: <span class="milk-star"></span> 50</div>
        <div style="margin-bottom:8px;"><a href="https://cissy.pythonanywhere.com" target="_blank" style="color:#605F5B;font-weight:500;text-decoration:underline;font-size:0.85rem;">https://cissy.pythonanywhere.com</a></div>
        <button class="btn-task" id="taskCompleteBtn">✅ Выполнил</button>
      </div>
    </div>

    <!-- ===== ПРОФИЛЬ ===== -->
    <div id="profileScreen" class="screen">
      <div class="profile-card" id="profileCard">
        <div class="profile-bg" id="profileBg"><div class="bg-overlay"></div></div>
        <div class="profile-content">
          <div class="profile-header">
            <div class="profile-avatar" id="avatarBtn">
              <span id="avatarEmoji">👤</span>
              <img id="avatarImg" style="display:none;">
              <div class="avatar-overlay">Сменить фото</div>
            </div>
            <div class="profile-name-wrap">
              <div class="profile-name">
                <span id="profileUsername" style="color:#605F5B;">User0000</span>
                <button class="edit-btn" id="editUsernameBtn">✎</button>
              </div>
              <div class="profile-status">
                <span class="status-badge" id="profileStatus">Новичок</span>
                <span id="profileTitle" style="display:block;font-size:0.65rem;color:#d4a843;font-weight:600;margin-top:2px;"></span>
              </div>
              <div class="profile-join">🕐 Зарегистрирован: <span id="profileJoinDate">сегодня</span></div>
            </div>
          </div>
          <div class="stats-grid">
