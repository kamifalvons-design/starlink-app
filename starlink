            <div class="stat-row"><span class="label">⭐ Звёзд</span><span class="value">${userData.stars}</span></div>
            <div class="stat-row"><span class="label">📋 Заданий выполнено</span><span class="value">${userData.tasks}</span></div>
            <div class="stat-row"><span class="label">👥 Рефералов</span><span class="value">${userData.refs}</span></div>
            <div class="stat-row"><span class="label">🎁 Донат</span><span class="value">${userData.donated} ⭐</span></div>
            <div class="stat-row"><span class="label">💰 Баланс</span><span class="value">${userData.balance} ⭐</span></div>
