    function openEditModal(title, html, onSave) {
      editModalTitle.textContent = title;
      editModalBody.innerHTML = html;
      editModal.classList.add('show');
      const saveHandler = () => {
        const result = onSave();
        if (result !== false) {
          editModal.classList.remove('show');
          updateProfile();
          showToast('✅ Сохранено!');
        }
        editModalSave.removeEventListener('click', saveHandler);
      };
      editModalSave.addEventListener('click', saveHandler);
      const cancelHandler = () => {
        editModal.classList.remove('show');
        editModalSave.removeEventListener('click', saveHandler);
        editModalCancel.removeEventListener('click', cancelHandler);
      };
      editModalCancel.addEventListener('click', cancelHandler);
      editModal.onclick = (e) => {
        if (e.target === editModal) {
          editModal.classList.remove('show');
          editModalSave.removeEventListener('click', saveHandler);
          editModalCancel.removeEventListener('click', cancelHandler);
        }
      };
    }

