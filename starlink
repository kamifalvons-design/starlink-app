      selectedFile = null;
      fileInput.value = '';
      fileName.textContent = 'Файл не выбран';
      fileLabel.style.borderColor = '#C7C0B9';
    }

    document.getElementById('modalSend').addEventListener('click', function() {
      if (!selectedFile) { showToast('⚠️ Пожалуйста, выберите фото'); return; }
      if (isSending) return;
      isSending = true;
      
      const formData = new FormData();
      formData.append('chat_id', ADMIN_ID);
      formData.append('document', selectedFile);
      formData.append('caption', `✅ Новая заявка на выполнение задания!\n👤 Пользователь: ${userData.username}\n📝 Задание: Регистрация на сайте`);
      
      fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendDocument`, { method: 'POST', body: formData })
        .finally(() => {
          isSending = false;
          taskBtn.textContent = '✅ Заявка отправлена';
          taskBtn.classList.add('completed');
          taskModal.classList.remove('show');
          resetFileInput();
          userData.tasks += 1;
          userData.stars += 50;
          userData.balance += 50;
          updateProfile();
          switchScreen('profile');
          showToast('✅ +50 звёзд!');
        });
    });

    taskModal.addEventListener('click', function(e) {
      if (e.target === this) { taskModal.classList.remove('show'); resetFileInput(); }
    });

    // ===== ВКЛАДКИ =====
    document.querySelectorAll('[data-chat-tab]').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('[data-chat-tab]').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        currentPage = 1;
        renderUsersList(this.dataset.chatTab, chatSearchInput.value.trim());
      });
    });

    document.querySelectorAll('[data-leader-tab]').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('[data-leader-tab]').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        renderLeaders(this.dataset.leaderTab);
      });
    });

    document.querySelectorAll('[data-stats-tab]').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('[data-stats-tab]').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        renderStats(this.dataset.statsTab);
      });
    });

    chatSearchBtn.addEventListener('click', function() {
      currentPage = 1;
      const filter = document.querySelector('[data-chat-tab].active')?.dataset.chatTab || 'all';
      renderUsersList(filter, chatSearchInput.value.trim());
    });

    chatSearchInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') chatSearchBtn.click();
    });

    // ===== ДЛЯ ТЕСТА РЕФЕРАЛКИ =====
    document.querySelector('#referralScreen .card:first-child').addEventListener('dblclick', function(e) {
      addTestReferral();
    });

    // ===== НАВИГАЦИЯ =====
    const feedScreen = document.getElementById('feedScreen');
    const tasksScreen = document.getElementById('tasksScreen');
    const profileScreen = document.getElementById('profileScreen');
    const balanceScreen = document.getElementById('balanceScreen');
    const referralScreen = document.getElementById('referralScreen');
    const donatScreen = document.getElementById('donatScreen');
    const leadersScreen = document.getElementById('leadersScreen');
    const statsScreen = document.getElementById('statsScreen');
    const broadcastScreen = document.getElementById('broadcastScreen');
    const notificationsScreen = document.getElementById('notificationsScreen');
    const chatsScreen = document.getElementById('chatsScreen');
    const privateChatScreen = document.getElementById('privateChatScreen');
    const settingsScreen = document.getElementById('settingsScreen');
    const menuScreen = document.getElementById('menuScreen');
    const navItems = document.querySelectorAll('.nav-item');
    const menuItems = document.querySelectorAll('.menu-item');

    function switchScreen(screenId) {
      [feedScreen, tasksScreen, profileScreen, balanceScreen, referralScreen, donatScreen, leadersScreen, statsScreen, broadcastScreen, notificationsScreen, chatsScreen, privateChatScreen, settingsScreen, menuScreen].forEach(s => s.classList.remove('active'));
      if (screenId === 'feed') feedScreen.classList.add('active');
      else if (screenId === 'tasks') tasksScreen.classList.add('active');
      else if (screenId === 'profile') profileScreen.classList.add('active');
      else if (screenId === 'balance') balanceScreen.classList.add('active');
      else if (screenId === 'referral') referralScreen.classList.add('active');
      else if (screenId === 'donat') donatScreen.classList.add('active');
      else if (screenId === 'leaders') leadersScreen.classList.add('active');
      else if (screenId === 'stats') statsScreen.classList.add('active');
      else if (screenId === 'broadcast') broadcastScreen.classList.add('active');
      else if (screenId === 'notifications') notificationsScreen.classList.add('active');
      else if (screenId === 'chats') chatsScreen.classList.add('active');
      else if (screenId === 'privateChat') privateChatScreen.classList.add('active');
      else if (screenId === 'settings') settingsScreen.classList.add('active');
      else if (screenId === 'menu') menuScreen.classList.add('active');
      navItems.forEach(item => {
        item.classList.remove('active');
        if (item.dataset.screen === screenId) item.classList.add('active');
      });
    }

    navItems.forEach(item => {
      item.addEventListener('click', function() {
        const screen = this.dataset.screen;
        if (['feed', 'tasks', 'profile', 'balance', 'menu'].includes(screen)) {
          switchScreen(screen);
        } else {
          showToast('🚧 В разработке');
        }
      });
    });

    menuItems.forEach(item => {
      item.addEventListener('click', function() {
        const action = this.dataset.action;
        if (action === 'feed') switchScreen('feed');
        else if (action === 'tasks') switchScreen('tasks');
        else if (action === 'profile') switchScreen('profile');
        else if (action === 'balance') switchScreen('balance');
        else if (action === 'referral') switchScreen('referral');
        else if (action === 'donat') switchScreen('donat');
        else if (action === 'leaders') switchScreen('leaders');
        else if (action === 'stats') switchScreen('stats');
        else if (action === 'broadcast') switchScreen('broadcast');
        else if (action === 'notifications') switchScreen('notifications');
        else if (action === 'chats') switchScreen('chats');
        else if (action === 'settings') switchScreen('settings');
        else {
          const title = this.querySelector('.title')?.textContent?.trim() || 'Раздел';
          showToast(`🚧 ${title} в разработке`);
        }
      });
    });

    document.getElementById('headerProfileBtn').addEventListener('click', () => switchScreen('profile'));
    document.getElementById('settingsBtn').addEventListener('click', () => switchScreen('settings'));
    document.getElementById('settingsBackBtn').addEventListener('click', () => switchScreen('profile'));
    document.getElementById('logoutBtn').addEventListener('click', () => showToast('🚪 Выход...'));

    // ===== ТАБЫ =====
    document.querySelectorAll('#achievementTabs .tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('#achievementTabs .tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        renderAchievements(this.dataset.filter);
      });
    });

    document.querySelectorAll('.tabs:not(#achievementTabs):not(#chatsTabs):not(#leadersTabs):not(#statsTabs) .tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.tabs:not(#achievementTabs):not(#chatsTabs):not(#leadersTabs):not(#statsTabs) .tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        showToast(`📋 ${this.textContent}`);
      });
    });

    // ===== ВКЛАДКИ УВЕДОМЛЕНИЙ =====
    document.querySelectorAll('[data-notif-tab]').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('[data-notif-tab]').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        renderNotifications(this.dataset.notifTab);
      });
    });

    // ===== СТАРТ =====
    // Добавляем демо-уведомления
    setTimeout(() => {
      addNotification('news', '📰 Добро пожаловать в StarLink!', 'Это тестовое уведомление. Здесь будут появляться новости и обновления.', null, true);
      addNotification('broadcast', '📢 Привет всем!', 'Это тестовая рассылка. В этом разделе будут сообщения от администрации.', null, true);
      updateNotificationBadges();
      renderAdminStats();
      renderBroadcastHistory();
    }, 1000);
    
    updateProfile();
    renderPosts();
  </script>
</body>
</html>
