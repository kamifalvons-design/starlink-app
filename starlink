<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>StarLink · Полный интерфейс</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }

    body {
      background-color: #F7F3EF;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 12px;
    }

    .app-card {
      max-width: 420px;
      width: 100%;
      background: #F7F3EF;
      border-radius: 32px;
      padding: 20px 16px 12px;
      border: 1px solid #EBE4DD;
      box-shadow: 0 8px 24px rgba(139, 135, 130, 0.08);
      max-height: 700px;
      overflow-y: auto;
    }

    .app-card::-webkit-scrollbar {
      width: 4px;
    }
    .app-card::-webkit-scrollbar-track {
      background: #EBE4DD;
      border-radius: 10px;
    }
    .app-card::-webkit-scrollbar-thumb {
      background: #C7C0B9;
      border-radius: 10px;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
      position: sticky;
      top: 0;
      background: #F7F3EF;
      z-index: 10;
      padding: 4px 0;
    }

    .app-title {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: #605F5B;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .app-title .mini {
      background: #EBE4DD;
      padding: 2px 10px;
      border-radius: 40px;
      font-size: 0.6rem;
      font-weight: 500;
      color: #8B8782;
      letter-spacing: 0.2px;
    }

    .user-badge {
      background: #EBE4DD;
      padding: 5px 12px 5px 10px;
      border-radius: 40px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.9rem;
      font-weight: 500;
      color: #605F5B;
      cursor: pointer;
      transition: 0.1s;
    }

    .user-badge:active {
      transform: scale(0.95);
    }

    .user-badge .stars {
      background: #F7F3EF;
      padding: 0 8px;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.75rem;
      color: #8B8782;
      border: 1px solid #C7C0B9;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .milk-star {
      display: inline-block;
      width: 14px;
      height: 14px;
      background: linear-gradient(145deg, #EBE4DD, #C7C0B9);
      clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
      filter: drop-shadow(0 1px 2px rgba(139, 135, 130, 0.2));
      flex-shrink: 0;
      vertical-align: middle;
    }

    .gold-star {
      display: inline-block;
      width: 14px;
      height: 14px;
      background: radial-gradient(circle at 40% 35%, #fce38a, #d4a843 60%, #b8922f);
      clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
      filter: drop-shadow(0 1px 2px rgba(184, 146, 47, 0.3));
      flex-shrink: 0;
      vertical-align: middle;
    }

    .screen {
      display: none;
      flex-direction: column;
      gap: 10px;
      margin: 6px 0 12px;
    }

    .screen.active {
      display: flex;
    }

    .card {
      background: #F7F3EF;
      border-radius: 20px;
      padding: 16px;
      border: 1px solid #EBE4DD;
    }

    .card-title {
      font-weight: 600;
      color: #605F5B;
      font-size: 0.85rem;
      margin-bottom: 8px;
      opacity: 0.7;
    }

    .empty-state {
      text-align: center;
      padding: 30px 20px;
      color: #8B8782;
      font-size: 0.95rem;
    }

    .empty-state .emoji {
      font-size: 2.5rem;
      display: block;
      margin-bottom: 10px;
    }

    .tabs {
      display: flex;
      gap: 6px;
      background: #EBE4DD;
      padding: 4px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      margin-bottom: 4px;
    }

    .tab {
      flex: 1;
      text-align: center;
      padding: 6px 0;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 500;
      color: #8B8782;
      cursor: pointer;
      transition: 0.15s;
      border: none;
      background: transparent;
    }

    .tab.active {
      background: #F7F3EF;
      color: #605F5B;
      border: 1px solid #C7C0B9;
      font-weight: 600;
    }

    .tab:active {
      background: #F7F3EF;
    }

    .profile-card {
      background: #F7F3EF;
      border-radius: 20px;
      padding: 16px;
      border: 1px solid #EBE4DD;
      position: relative;
      overflow: hidden;
      transition: 0.3s;
      min-height: 200px;
    }

    .profile-card .profile-bg {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: #EBE4DD;
      z-index: 0;
      background-size: cover;
      background-position: center;
      transition: 0.3s;
    }

    .profile-card .profile-bg .bg-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(247, 243, 239, 0.75);
      backdrop-filter: blur(2px);
    }

    .profile-card .profile-content {
      position: relative;
      z-index: 1;
    }

    .profile-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: #EBE4DD;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      border: 3px solid #F7F3EF;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      cursor: pointer;
      transition: 0.1s;
      overflow: hidden;
      flex-shrink: 0;
      position: relative;
    }

    .profile-avatar:active {
      transform: scale(0.95);
    }

    .profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-avatar .avatar-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(96, 95, 91, 0.7);
      color: #F7F3EF;
      font-size: 0.5rem;
      padding: 2px 0;
      text-align: center;
      opacity: 0;
      transition: 0.2s;
    }

    .profile-avatar:hover .avatar-overlay {
      opacity: 1;
    }

    .profile-header {
      display: flex;
      gap: 14px;
      align-items: center;
    }

    .profile-name-wrap {
      flex: 1;
    }

    .profile-name {
      font-size: 1.2rem;
      font-weight: 700;
      color: #605F5B;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .profile-name .edit-btn {
      font-size: 0.65rem;
      background: rgba(235, 228, 221, 0.8);
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 0 8px;
      cursor: pointer;
      color: #8B8782;
      font-weight: 500;
      transition: 0.1s;
      line-height: 1.6;
    }

    .profile-name .edit-btn:active {
      transform: scale(0.95);
      background: #C7C0B9;
    }

    .profile-status {
      font-size: 0.75rem;
      color: #8B8782;
      margin-top: 2px;
    }

    .profile-status .status-badge {
      background: rgba(235, 228, 221, 0.8);
      padding: 0 8px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      font-weight: 500;
      color: #605F5B;
    }

    .profile-join {
      font-size: 0.65rem;
      color: #8B8782;
      margin-top: 2px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-top: 12px;
    }

    .stat-item {
      background: rgba(247, 243, 239, 0.7);
      backdrop-filter: blur(4px);
      border-radius: 12px;
      padding: 8px 4px;
      text-align: center;
      border: 1px solid #C7C0B9;
    }

    .stat-item .value {
      font-size: 1.1rem;
      font-weight: 700;
      color: #605F5B;
    }

    .stat-item .label {
      font-size: 0.55rem;
      color: #8B8782;
      margin-top: 1px;
    }

    .profile-bio {
      font-size: 0.85rem;
      color: #605F5B;
      padding: 8px 12px;
      background: rgba(235, 228, 221, 0.7);
      backdrop-filter: blur(4px);
      border-radius: 12px;
      border: 1px solid #C7C0B9;
      cursor: pointer;
      transition: 0.1s;
      word-wrap: break-word;
      min-height: 36px;
      display: flex;
      align-items: center;
      margin-top: 10px;
    }

    .profile-bio:active {
      transform: scale(0.98);
    }

    .profile-bio.empty {
      color: #C7C0B9;
      font-style: italic;
    }

    .profile-bio .edit-bio-btn {
      margin-left: auto;
      font-size: 0.6rem;
      background: rgba(247, 243, 239, 0.7);
      border: 1px solid #C7C0B9;
      border-radius: 40px;
      padding: 0 8px;
      cursor: pointer;
      color: #8B8782;
      font-weight: 500;
      transition: 0.1s;
      line-height: 1.6;
    }

    .profile-bio .edit-bio-btn:active {
      transform: scale(0.95);
      background: #C7C0B9;
    }

    .achievement-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      background: #EBE4DD;
      border-radius: 12px;
      border: 1px solid #C7C0B9;
      margin-bottom: 4px;
      transition: 0.1s;
    }

    .achievement-item.unlocked {
      border-color: #605F5B;
      background: #F7F3EF;
    }

    .achievement-item.locked {
      opacity: 0.6;
    }

    .achievement-item .icon {
      font-size: 1.5rem;
      width: 32px;
      text-align: center;
    }

    .achievement-item .info {
      flex: 1;
    }

    .achievement-item .info .name {
      font-weight: 600;
      color: #605F5B;
      font-size: 0.9rem;
    }

    .achievement-item .info .desc {
      font-size: 0.7rem;
      color: #8B8782;
    }

    .achievement-item .info .progress {
      font-size: 0.65rem;
      color: #605F5B;
      font-weight: 500;
    }

    .achievement-item .info .reward {
      font-size: 0.65rem;
      color: #d4a843;
      font-weight: 600;
    }

    .achievement-item .status-badge {
      font-size: 0.6rem;
      padding: 2px 10px;
      border-radius: 40px;
      font-weight: 500;
    }

    .achievement-item .status-badge.unlocked {
      background: #605F5B;
      color: #F7F3EF;
    }

    .achievement-item .status-badge.locked {
      background: #EBE4DD;
      color: #8B8782;
      border: 1px solid #C7C0B9;
    }

    .nick-history {
      font-size: 0.8rem;
      color: #8B8782;
      padding: 4px 0;
    }

    .nick-history .nick-item {
      display: flex;
      justify-content: space-between;
      padding: 2px 0;
      border-bottom: 1px dashed #EBE4DD;
    }

    .nick-history .nick-item:last-child {
      border-bottom: none;
    }

    .balance-display {
      text-align: center;
      padding: 8px 0;
    }

    .balance-display .label {
      font-size: 0.8rem;
      color: #8B8782;
    }

    .balance-display .amount {
      font-size: 2.5rem;
      font-weight: 700;
      color: #605F5B;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .balance-display .amount .milk-star {
      width: 28px;
      height: 28px;
    }

    .balance-display .sub {
      font-size: 0.7rem;
      color: #8B8782;
      margin-top: 2px;
    }

    .withdraw-form .field {
      margin-bottom: 10px;
    }

    .withdraw-form .field-label {
      font-size: 0.8rem;
      color: #8B8782;
      margin-bottom: 4px;
      display: block;
    }

    .withdraw-form .field-input {
      width: 100%;
      border: 1px solid #C7C0B9;
      border-radius: 16px;
      padding: 10px 14px;
      font-size: 0.9rem;
      background: #F7F3EF;
      color: #605F5B;
      outline: none;
      font-family: inherit;
    }

    .withdraw-form .field-input:focus {
      border-color: #8B8782;
    }

    .withdraw-form .field-input::placeholder {
      color: #C7C0B9;
    }

    .withdraw-form .field-hint {
      font-size: 0.7rem;
      color: #8B8782;
      margin-top: 2px;
    }

    .btn-withdraw {
      background: #605F5B;
      color: #F7F3EF;
      border: none;
      padding: 12px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.1s;
      width: 100%;
      margin-top: 4px;
    }

    .btn-withdraw:active {
      background: #8B8782;
      transform: scale(0.98);
    }

    .btn-withdraw:disabled {
      background: #C7C0B9;
      cursor: not-allowed;
      opacity: 0.6;
    }

    .history-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid #EBE4DD;
    }

    .history-item:last-child {
      border-bottom: none;
    }

    .history-item .left {
      display: flex;
      flex-direction: column;
    }

    .history-item .left .type {
      font-size: 0.85rem;
      font-weight: 500;
      color: #605F5B;
    }

    .history-item .left .date {
      font-size: 0.65rem;
      color: #8B8782;
    }

    .history-item .right {
      font-weight: 600;
      font-size: 0.9rem;
    }

    .history-item .right.positive {
      color: #4CAF50;
    }

    .history-item .right.negative {
      color: #E53935;
    }

    .ref-link-box {
      background: #EBE4DD;
      border-radius: 16px;
      padding: 10px 14px;
      border: 1px solid #C7C0B9;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 10px;
    }

    .ref-link-box .link {
      font-size: 0.8rem;
      color: #605F5B;
      word-break: break-all;
      flex: 1;
    }

    .ref-link-box .copy-btn {
      background: #605F5B;
      color: #F7F3EF;
      border: none;
      border-radius: 40px;
      padding: 4px 12px;
      font-size: 0.7rem;
      font-weight: 500;
      cursor: pointer;
      transition: 0.1s;
      flex-shrink: 0;
    }

    .ref-link-box .copy-btn:active {
      transform: scale(0.95);
      background: #8B8782;
    }

    .ref-stats {
      display: flex;
      justify-content: space-between;
      background: #EBE4DD;
      border-radius: 12px;
      padding: 10px 14px;
      border: 1px solid #C7C0B9;
      margin-bottom: 10px;
    }

    .ref-stats .item {
      text-align: center;
    }

    .ref-stats .item .number {
      font-size: 1.2rem;
      font-weight: 700;
      color: #605F5B;
    }

    .ref-stats .item .label {
      font-size: 0.6rem;
      color: #8B8782;
    }

    .ref-user-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 10px;
      background: #EBE4DD;
      border-radius: 12px;
      border: 1px solid #C7C0B9;
      margin-bottom: 4px;
    }

    .ref-user-item .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #C7C0B9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      color: #F7F3EF;
      font-weight: 600;
      flex-shrink: 0;
    }

    .ref-user-item .info {
      flex: 1;
    }

    .ref-user-item .info .name {
      font-size: 0.85rem;
      font-weight: 500;
      color: #605F5B;
    }

    .ref-user-item .info .date {
      font-size: 0.6rem;
      color: #8B8782;
    }

    .ref-user-item .badge {
      font-size: 0.6rem;
      background: #F7F3EF;
      padding: 2px 8px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      color: #8B8782;
    }

    .task-card {
      background: #EBE4DD;
      border-radius: 16px;
      padding: 14px;
      border: 1px solid #C7C0B9;
      margin-bottom: 10px;
    }

    .task-title {
      font-weight: 600;
      color: #605F5B;
      font-size: 0.95rem;
    }

    .task-desc {
      font-size: 0.8rem;
      color: #8B8782;
      margin: 4px 0 8px;
    }

    .task-reward {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 500;
      color: #605F5B;
      font-size: 0.85rem;
      margin-bottom: 10px;
    }

    .btn-task {
      background: #605F5B;
      color: #F7F3EF;
      border: none;
      padding: 8px 16px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      transition: 0.1s;
      width: 100%;
    }

    .btn-task:active {
      background: #8B8782;
      transform: scale(0.98);
    }

    .btn-task.completed {
      background: #8B8782;
      opacity: 0.7;
      cursor: default;
    }

    .create-post {
      background: #EBE4DD;
      border-radius: 20px;
      padding: 14px;
      border: 1px solid #C7C0B9;
      margin-bottom: 8px;
    }

    .create-post .greeting {
      font-size: 0.9rem;
      font-weight: 500;
      color: #605F5B;
      margin-bottom: 8px;
    }

    .create-post .greeting strong {
      font-weight: 700;
    }

    .create-post textarea {
      width: 100%;
      border: 1px solid #C7C0B9;
      border-radius: 16px;
      padding: 10px 12px;
      font-size: 0.85rem;
      resize: none;
      background: #F7F3EF;
      color: #605F5B;
      outline: none;
      font-family: inherit;
      min-height: 60px;
    }

    .create-post textarea:focus {
      border-color: #8B8782;
    }

    .post-actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 8px;
      align-items: center;
    }

    .post-btn {
      padding: 5px 12px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      background: #F7F3EF;
      font-size: 0.7rem;
      font-weight: 500;
      color: #605F5B;
      cursor: pointer;
      transition: 0.1s;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .post-btn:active {
      background: #EBE4DD;
      transform: scale(0.95);
    }

    .post-btn.publish {
      background: #605F5B;
      color: #F7F3EF;
      border-color: #605F5B;
      font-weight: 600;
      margin-left: auto;
    }

    .post-btn.publish:active {
      background: #8B8782;
    }

    .anon-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      color: #8B8782;
      cursor: pointer;
      padding: 4px 10px;
      border-radius: 40px;
      border: 1px solid #C7C0B9;
      background: #F7F3EF;
      transition: 0.1s;
      user-select: none;
    }

    .anon-toggle:active {
      transform: scale(0.95);
    }

    .anon-toggle.active {
      border-color: #605F5B;
      background: #EBE4DD;
      color: #605F5B;
    }

    .anon-toggle .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #C7C0B9;
      transition: 0.2s;
    }

    .anon-toggle.active .dot {
      background: #605F5B;
    }

    .post {
      background: #F7F3EF;
      border-radius: 20px;
      padding: 14px 16px;
      border: 1px solid #EBE4DD;
      margin-bottom: 10px;
    }

    .post-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }

    .post-author {
      font-weight: 600;
      color: #605F5B;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.1s;
    }

    .post-author:active {
      opacity: 0.6;
    }

    .post-author.anonymous {
      color: #8B8782;
      font-style: italic;
    }

    .post-time {
      font-size: 0.65rem;
      color: #8B8782;
      margin-left: auto;
    }

    .post-badge {
      font-size: 0.55rem;
      background: #EBE4DD;
      padding: 1px 8px;
      border-radius: 40px;
      color: #8B8782;
    }

    .post-text {
      color: #605F5B;
      font-size: 0.9rem;
      line-height: 1.4;
      margin-bottom: 6px;
      word-wrap: break-word;
    }

    .post-image {
      width: 100%;
      border-radius: 12px;
      margin: 6px 0;
      max-height: 200px;
      object-fit: cover;
