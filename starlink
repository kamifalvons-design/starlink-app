    // ===== ФОН ПРОФИЛЯ =====
    function setProfileBg(imageData) {
      userData.bgImage = imageData;
      if (imageData) {
        profileBg.style.backgroundImage = `url(${imageData})`;
        profileBg.style.backgroundSize = 'cover';
        profileBg.style.backgroundPosition = 'center';
      } else {
        profileBg.style.backgroundImage = 'none';
        profileBg.style.backgroundColor = '#EBE4DD';
      }
    }

    function changeBg() {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.onchange = (e) => {
        if (e.target.files && e.target.files[0]) {
          const reader = new FileReader();
          reader.onload = (ev) => {
            setProfileBg(ev.target.result);
            showToast('✅ Фон обновлён!');
          };
          reader.readAsDataURL(e.target.files[0]);
        }
      };
      input.click();
    }
    document.getElementById('settingsEditBg').addEventListener('click', changeBg);

    // ===== ОБНОВЛЕНИЕ ДОСТИЖЕНИЙ =====
    function checkAchievements() {
      let newUnlocked = [];
      ACHIEVEMENTS.forEach(a => {
        if (a.check(userData) && !userData.unlockedAchievements.includes(a.id)) {
          newUnlocked.push(a.id);
          if (a.reward > 0) {
            userData.stars += a.reward;
            userData.balance += a.reward;
            showToast(`🏅 Достижение разблокировано: ${a.name}! +${a.reward} ⭐`);
          } else {
            showToast(`🏅 Достижение разблокировано: ${a.name}!`);
          }
        }
      });
      userData.unlockedAchievements = [...userData.unlockedAchievements, ...newUnlocked];
    }

    // ===== ОБНОВЛЕНИЕ ТИТУЛОВ =====
    function updateTitles() {
      let currentTitle = null;
      TITLES.forEach(title => {
        if (userData.donated >= title.min && userData.donated <= title.max) {
          currentTitle = title.name;
        }
        if (userData.donated >= title.min && title.max === Infinity) {
          currentTitle = title.name;
        }
      });
      
      userData.title = currentTitle;
      if (currentTitle) {
        profileTitle.textContent = `👑 ${currentTitle}`;
        profileTitle.style.display = 'block';
      } else {
        profileTitle.textContent = '';
        profileTitle.style.display = 'none';
      }

      TITLES.forEach(title => {
        const isUnlocked = userData.donated >= title.min;
        const statusEl = document.getElementById(`titleStatus${title.min}`);
        if (statusEl) {
          statusEl.textContent = isUnlocked ? '✅ Получено' : '🔒 Закрыто';
          statusEl.className = `status ${isUnlocked ? 'unlocked' : 'locked'}`;
        }
      });
    }

    // ===== ОБНОВЛЕНИЕ ПРОФИЛЯ =====
    function updateProfile() {
      headerUsername.textContent = userData.username;
      headerUsername.style.color = userData.nicknameColor;
      headerStars.textContent = userData.stars;
      feedUsername.textContent = userData.username;
      profileUsername.textContent = userData.username;
      profileUsername.style.color = userData.nicknameColor;
      profileStatus.textContent = userData.status;
      profileJoinDate.textContent = userData.joinDate;
      statStars.textContent = userData.stars;
      statTasks.textContent = userData.tasks;
      statRefs.textContent = userData.refs;
      statDonated.textContent = userData.donated;
      settingsUsername.textContent = userData.username;
      settingsStatus.textContent = userData.status;
      balanceAmount.textContent = userData.balance;
      colorPreview.style.backgroundColor = userData.nicknameColor;

      if (userData.bio && userData.bio.trim() !== '' && userData.bio !== 'Расскажи о себе...') {
        bioText.textContent = userData.bio;
        settingsBio.textContent = userData.bio;
        profileBio.classList.remove('empty');
      } else {
        bioText.textContent = 'Расскажи о себе...';
        settingsBio.textContent = 'Расскажи о себе...';
        profileBio.classList.add('empty');
      }

      if (userData.avatar) {
        avatarImg.src = userData.avatar;
        avatarImg.style.display = 'block';
        avatarEmoji.style.display = 'none';
      } else {
        avatarImg.style.display = 'none';
        avatarEmoji.style.display = 'block';
      }

      if (userData.bgImage) {
        profileBg.style.backgroundImage = `url(${userData.bgImage})`;
        profileBg.style.backgroundSize = 'cover';
        profileBg.style.backgroundPosition = 'center';
      }

      nickHistory.innerHTML = userData.nickHistory.map((nick, i) => `
        <div class="nick-item"><span>${nick}</span><span style="font-size:0.65rem;color:#C7C0B9;">${i === 0 ? 'сейчас' : 'раньше'}</span></div>
      `).join('');

      checkAchievements();
      renderAchievements('all');
      renderHistory();
      updateReferral();
      updateTitles();
      updateBroadcastStatus();
      renderLeaders(document.querySelector('[data-leader-tab].active')?.dataset.leaderTab || 'tasks');
      renderStats(document.querySelector('[data-stats-tab].active')?.dataset.statsTab || 'personal');
      renderUsersList(document.querySelector('[data-chat-tab].active')?.dataset.chatTab || 'all', chatSearchInput.value.trim());
    }

    // ===== РЕНДЕР ДОСТИЖЕНИЙ =====
    function renderAchievements(filter = 'all') {
      let filtered = ACHIEVEMENTS;
      if (filter === 'unlocked') {
        filtered = ACHIEVEMENTS.filter(a => userData.unlockedAchievements.includes(a.id));
      } else if (filter === 'locked') {
        filtered = ACHIEVEMENTS.filter(a => !userData.unlockedAchievements.includes(a.id));
      }
      if (filtered.length === 0) {
        achievementsList.innerHTML = `<div class="empty-state" style="padding:12px;"><span style="font-size:0.85rem;">Нет достижений</span></div>`;
        return;
      }
      achievementsList.innerHTML = filtered.map(a => {
        const unlocked = userData.unlockedAchievements.includes(a.id);
        const progress = a.progress(userData);
        return `
          <div class="achievement-item ${unlocked ? 'unlocked' : 'locked'}">
            <div class="icon">${a.icon}</div>
            <div class="info">
              <div class="name">${a.name}</div>
              <div class="desc">${a.desc}</div>
              <div class="progress">${progress}/${a.max}</div>
              ${a.reward > 0 ? `<div class="reward">🎁 Награда: +${a.reward} ⭐</div>` : ''}
            </div>
            <div class="status-badge ${unlocked ? 'unlocked' : 'locked'}">${unlocked ? '✅ Получено' : '🔒 Закрыто'}</div>
          </div>
        `;
      }).join('');
    }

    // ===== РЕНДЕР ИСТОРИИ =====
    function renderHistory() {
      if (userData.history.length === 0) {
        historyContainer.innerHTML = `<div class="empty-state"><span class="emoji">📭</span>Пока нет операций</div>`;
        return;
      }
      historyContainer.innerHTML = userData.history.map(item => `
