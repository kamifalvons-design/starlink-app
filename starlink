    // ===== ОТМЕТКА О ПРОСМОТРЕ =====
    function markAsViewed(notifId, channel) {
      const notif = notifications[channel].find(n => n.id === notifId);
      if (notif && !notif.read) {
        notif.read = true;
        if (!notif.views.includes(userData.username)) {
          notif.views.push(userData.username);
        }
        if (channel === 'broadcast') {
          const historyEntry = broadcastHistory.find(h => h.title === notif.title && h.text === notif.text);
          if (historyEntry && !historyEntry.views.includes(userData.username)) {
            historyEntry.views.push(userData.username);
            renderBroadcastHistory();
          }
        }
        updateNotificationBadges();
        renderNotifications(document.querySelector('[data-notif-tab].active')?.dataset.notifTab || 'all');
        renderAdminStats();
      }
    }

